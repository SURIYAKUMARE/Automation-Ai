# ==============================================================================
# SocialSync AI - Production & Development Environment Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Database, Authentication & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# Google Gemini Multimodal AI
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# ------------------------------------------------------------------------------
# OAuth Provider Credentials (Official Developer Consoles)
# ------------------------------------------------------------------------------

# LinkedIn (Developer Portal: https://developer.linkedin.com)
# Scopes: openid, profile, email, w_member_social
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Google & YouTube (Google Cloud Console: https://console.cloud.google.com)
# Scopes: https://www.googleapis.com/auth/youtube.upload, https://www.googleapis.com/auth/youtube.readonly
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Meta / Instagram & Facebook (Meta for Developers: https://developers.facebook.com)
# Scopes: pages_show_list, pages_read_engagement, pages_manage_posts, instagram_basic, instagram_content_publish
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# ------------------------------------------------------------------------------
# Worker & Security Configuration
# ------------------------------------------------------------------------------
# Redis connection URL for persistent queue workers (optional in local development)
REDIS_URL=redis://default:password@localhost:6379

# 32-byte hexadecimal key for AES-256-GCM OAuth token encryption at rest
# Generate using: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
