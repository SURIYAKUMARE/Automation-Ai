# Server URL registered with OAuth providers. Use HTTPS in production.
APP_URL=http://localhost:3000
# Public address shown on /privacy for access and deletion requests.
PRIVACY_CONTACT_EMAIL=

# Supabase project and service role. Use one of the two server key names.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Optional browser SDK values for consumers of the existing Supabase client helper.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred for new projects. Use the anon key below only for legacy projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Use distinct randomly generated 32-byte hexadecimal values.
# node -p "require('node:crypto').randomBytes(32).toString('hex')"
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# Optional decryption-only key during a planned rotation of a previously private key.
# TOKEN_ENCRYPTION_PREVIOUS_KEY=
CRON_SECRET=
# Optional paths if the media binaries are not on PATH.
# FFMPEG_PATH=
# FFPROBE_PATH=
# Optional worker override for internal networking.
# WORKER_APP_URL=http://localhost:3000

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Sign-In and YouTube Data API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional separate OAuth client for YouTube. Set both values together.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional. Restrict this API key to YouTube Data API v3.
YOUTUBE_TRENDS_API_KEY=

# Meta Graph. Enable extra insights scopes after Meta grants access.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_ENABLE_INSIGHTS=false
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# LinkedIn. Enable member analytics after LinkedIn grants product access.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610
LINKEDIN_ENABLE_MEMBER_ANALYTICS=false
